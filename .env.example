# Pipeline Configuration
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=15.0
MAX_RETRIES=2
REQUEST_DELAY=0.2

# Verification Thresholds
SHOPIFY_THRESHOLD=5
INDIA_THRESHOLD=7

# Discovery Settings
MAX_DISCOVERY_PAGES=100
